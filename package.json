{
  "name": "jartic-regulation-sprite",
  "version": "0.1.0",
  "private": true,
  "description": "JARTIC 交通規制情報の共通規制種別コードごとのアイコンを MapLibre 向けスプライトとして配信する",
  "scripts": {
    "icons": "python tools/gen_icons.py",
    "prebuild": "node -e \"require('fs').mkdirSync('_site',{recursive:true})\"",
    "build": "sprite-one -i ./icons -r1 -r2 ./_site/sprite",
    "postbuild": "python tools/gen_site.py",
    "docs": "python tools/gen_icon_list.py",
    "verify": "python tools/verify_icons.py",
    "start": "npm run build && npx http-server -c-1 ./_site"
  },
  "license": "MIT",
  "dependencies": {
    "@unvt/sprite-one": "^0.1.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
